{
  "name": "Azure DevOps",
  "rules": [
    {
      "id": "ado-pr",
      "name": "One pull request tab",
      "patterns": [
        "dev.azure.com/*/*/_git/*/pullrequest/*",
        "*.visualstudio.com/*/_git/*/pullrequest/*"
      ],
      "onMatch": "navigate"
    },
    {
      "id": "ado-work-item",
      "name": "One work item tab",
      "patterns": [
        "dev.azure.com/*/*/_workitems/edit/*",
        "*.visualstudio.com/*/_workitems/edit/*"
      ],
      "onMatch": "navigate"
    },
    {
      "id": "ado-build",
      "name": "One pipeline run tab",
      "patterns": [
        "dev.azure.com/*/*/_build/results",
        "*.visualstudio.com/*/_build/results"
      ],
      "onMatch": "navigate"
    }
  ]
}
